{
  "manifest_version": 3,
  "name": "CleanWeb MAX Ad Blocker",
  "version": "2.0.0",
  "description": "Агрессивная блокировка рекламы, трекеров, попапов и YouTube-рекламы + SponsorBlock и автообновляемые фильтры.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "core_rules",
        "enabled": true,
        "path": "rules_core.json"
      },
      {
        "id": "aggressive_rules",
        "enabled": true,
        "path": "rules_aggressive.json"
      },
      {
        "id": "youtube_rules",
        "enabled": true,
        "path": "rules_youtube.json"
      }
    ]
  },
  "action": {
    "default_title": "CleanWeb MAX",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page_guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}